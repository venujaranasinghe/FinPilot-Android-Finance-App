rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own top-level profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Income entries — owner only
      match /income/{incomeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Expense entries — owner only
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Savings goals — owner only (including nested savingsLogs)
      match /goals/{goalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /savingsLogs/{logId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Freelance projects — owner only
      match /freelanceProjects/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Crypto holdings — owner only
      match /cryptoHoldings/{holdingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subscriptions — owner only
      match /subscriptions/{subscriptionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
